<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block access to sensitive database & environment files
  RewriteRule \.(sqlite|db|env|git|log|md|sql)$ - [F,L]
  RewriteRule "(^|/)\." - [F]

  # Handle OPTIONS HTTP preflight requests
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=200,L]

  # Auto-rewrite /api/endpoint to /api/endpoint.php if .php file exists
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # Direct execution for requests targeting physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct execution for API directory scripts
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Redirect all other Single Page App (SPA) routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
